{
  "expo": {
    "name": "Gym Log",
    "slug": "gym-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gymlog",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.gymlog.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B57D0",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8FF",
          "dark": {
            "backgroundColor": "#10131C"
          },
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/roboto/400Regular/Roboto_400Regular.ttf",
            "./node_modules/@expo-google-fonts/roboto/500Medium/Roboto_500Medium.ttf",
            "./node_modules/@expo-google-fonts/roboto/700Bold/Roboto_700Bold.ttf"
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
